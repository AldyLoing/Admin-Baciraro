# =============================================================
# Baciraro Admin — Environment Variables
# Salin ke .env.local (development) atau set di Vercel Environment
# Variables. Pakai nilai Supabase project yang SAMA dengan
# Baciraro utama.
# =============================================================

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_KEY=

# Auth admin (opsional; default "baciraro-secret-dev")
JWT_SECRET=

# Google Calendar sync (opsional; kalau pakai fitur kalender)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Diarahkan ke domain deploy: https://<domain>/api/admin/google/callback
GOOGLE_REDIRECT_URI=
GOOGLE_CALENDAR_ID=
NEXT_PUBLIC_GOOGLE_CALENDAR_EMAIL=